    ]
   ]
  },
  {
   "key": "dust_of_shadows",
   "title": "Dust of Shadows",
   "level": 4,
   "giver": "brannoc",
   "requires": [
    "eyes_in_the_dark"
   ],
   "text": "When a Shade comes apart it leaves dust behind. In the old days we fed that dust to the Great Hearth and it burned brighter for it. Bring me 8.",
   "done": "Feel how cold it is? Cold enough to burn.",
   "objectives": [
    {
     "collect": "shade_dust",
     "count": 8
    }
   ],
   "money": 120
  },
  {
   "key": "hearth_stirs",
