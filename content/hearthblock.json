     4
    ]
   ],
   "requires": []
  },
  {
   "key": "thin_the_herd",
   "title": "Thinning the Herd",
   "level": 2,
   "giver": "maren",
   "requires": [
    "cold_hearth"
   ],
   "text": "The Grazers have grown bold without the Watch to drive them off, and they trample our gardens. Thin the herd: 8 of them should do.",
   "done": "That's better. Take one of these. You've earned it.",
   "objectives": [
    {
     "kill": "grazer",
     "count": 8
    }
   ],
   "money": 60,
   "choice": [
    [
     "stone_sword",
     1
    ],
    [
     "stone_axe",
     1
    ]
   ]
  },
  {
   "key": "kindling",
   "title": "Kindling",
   "level": 2,
   "giver": "brannoc",
   "requires": [
    "cold_hearth"
   ],
   "text": "If we are ever to relight the Great Hearth we will need wood. Bring me 10 logs from the woods. Trees grow back here, faster than you'd think.",
   "done": "Good, dry wood. Take this pick. The stone will need breaking too.",
   "objectives": [
    {
     "collect": "log",
     "count": 10
    }
   ],
   "money": 50,
   "items": [
    [
     "stone_pickaxe",
     1
    ]
   ]
  },
  {
   "key": "wool_for_winter",
   "title": "Wool for Winter",
   "level": 2,
   "giver": "tilda",
   "requires": [
    "meat_for_the_pot"
   ],
   "text": "Nights are cold and blankets are thin. Grazer wool, 6 bundles of it, and I'll stitch something warm.",
   "done": "Soft as anything. Take this. A bed of your own, so you wake somewhere better than the hearth.",
   "objectives": [
    {
     "collect": "white",
     "count": 6
    }
   ],
   "money": 60,
   "items": [
    [
     "bed",
     1
    ]
   ]
  },
  {
   "key": "coal_for_the_watch",
   "title": "Coal for the Watch",
   "level": 3,
   "giver": "brannoc",
   "requires": [
    "kindling"
   ],
   "text": "Light keeps the Shades back. Torches need coal. Look for black-flecked stone in the hillsides and cave mouths and bring me 6 coal.",
   "done": "Torches for the Watch, and some for you. Shades cannot rise in good light.",
   "objectives": [
    {
     "collect": "coal",
     "count": 6
    }
   ],
   "money": 70,
   "items": [
    [
     "torch",
     16
    ]
   ]
  },
  {
   "key": "north_watch",
   "title": "The North Watch",
   "level": 3,
   "giver": "maren",
   "requires": [
    "thin_the_herd"
   ],
   "text": "Before the dark came, we kept a beacon north of here. Go and find it. Its lantern may still burn. Follow the tracker north.",
   "progress": "Have you found the beacon?",
   "done": "Still burning? Then not all is lost.",
   "objectives": [
    {
     "explore": "the North Watch beacon",
     "at": [
      0,
      0,
      -56
     ],
     "radius": 7
    }
   ],
   "money": 80
  },
  {
   "key": "eyes_in_the_dark",
   "title": "Eyes in the Dark",
   "level": 3,
   "giver": "maren",
   "requires": [
    "north_watch"
   ],
   "text": "Shades rise when the sun goes down, and in deep caves at any hour. They cannot cross into a hearth's light. Fight from the light if you can. Destroy 5 of them.",
   "progress": "Wait for dusk, or go below. They'll come.",
   "done": "Five fewer pairs of eyes. You fight like a Watchman.",
   "objectives": [
    {
     "kill": "shade",
     "count": 5
    }
   ],
   "money": 120,
   "choice": [
