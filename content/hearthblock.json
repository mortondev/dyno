   ]
  },
  {
   "key": "iron_for_hollis",
   "title": "Iron for Hollis",
   "level": 4,
   "giver": "hollis",
   "requires": [
    "coal_for_the_watch"
   ],
   "text": "The iron seams run deeper than coal: rust-red flecks in the stone. A stone pickaxe will do. Bring me 6 raw iron and I'll show you what a forge can do.",
   "done": "Good ore. Here, a proper pick, from my own anvil.",
   "objectives": [
    {
     "collect": "raw_iron",
     "count": 6
    }
   ],
   "money": 100,
   "items": [
