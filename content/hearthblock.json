 "quests": [
  {
   "key": "cold_hearth",
   "title": "The Cold Hearth",
   "level": 1,
   "giver": "brannoc",
   "ender": "maren",
   "text": "You've woken by the old hearth like the rest of us, I see. Shades took the valley the night the Great Hearth went out. If you mean to help, Captain Maren keeps what's left of the Watch. Go and speak with her.",
   "done": "Brannoc sent you? Good. We need every pair of hands.",
   "objectives": [
    {
     "talk": "maren"
    }
   ],
   "xp": 120,
   "money": 10,
   "requires": []
  },
  {
   "key": "meat_for_the_pot",
   "title": "Meat for the Pot",
   "level": 1,
   "giver": "tilda",
   "text": "Grazers wander the meadows around Hearthstead. Bring me 4 pieces of raw meat and I'll make sure nobody fights on an empty stomach.",
   "progress": "No meat, no stew.",
   "done": "Lovely. Here, take some of yesterday's.",
   "objectives": [
    {
     "collect": "raw_meat",
     "count": 4
    }
   ],
   "money": 40,
   "items": [
